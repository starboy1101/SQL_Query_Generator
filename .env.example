APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Set in staging/production. Send it to API endpoints as X-API-Key.
API_KEY=
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=frontend/dist
METRICS_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Use a dedicated read-only database account outside local development.
DATABASE_URL=sqlite:///./data/demo.db
DATABASE_DIALECT=sqlite
DATABASE_SCHEMA=
ALLOWED_TABLES=customers,orders,order_items,products
ALLOW_QUERY_EXECUTION=true
ALLOW_DIRECT_SQL_EXECUTION=false
DEFAULT_MAX_ROWS=100
MAX_ROWS_CAP=1000
QUERY_TIMEOUT_SECONDS=10

# heuristic is a lightweight local smoke-test backend.
# Other values: huggingface, huggingface_space, or openai_compatible.
LLM_BACKEND=heuristic
MODEL_NAME_OR_PATH=codellama/CodeLlama-7b-Instruct-hf
ADAPTER_PATH=
MODEL_DEVICE=auto
MODEL_USE_4BIT=true
MODEL_WARMUP_ON_START=false
MODEL_MAX_INPUT_TOKENS=3072
MODEL_MAX_NEW_TOKENS=256
MODEL_REQUEST_TIMEOUT_SECONDS=120

# Used only by LLM_BACKEND=huggingface_space.
HF_SPACE_ID=
HF_SPACE_API_NAME=/generate
# Optional read token for a private Space. Keep this server-side; never use VITE_*.
HF_SPACE_TOKEN=

# Used only by LLM_BACKEND=openai_compatible.
MODEL_API_BASE_URL=http://localhost:8001
MODEL_API_KEY=
