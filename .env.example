APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Set in staging/production. Send it to API endpoints as X-API-Key.
API_KEY=

# Use a dedicated read-only database account outside local development.
DATABASE_URL=sqlite:///./data/demo.db
DATABASE_DIALECT=sqlite
DATABASE_SCHEMA=
ALLOWED_TABLES=customers,orders,order_items,products
ALLOW_QUERY_EXECUTION=true
DEFAULT_MAX_ROWS=100
MAX_ROWS_CAP=1000
QUERY_TIMEOUT_SECONDS=10

# heuristic is a lightweight local smoke-test backend.
# Set to huggingface for an in-process CodeLlama model, or openai_compatible for vLLM/TGI.
LLM_BACKEND=heuristic
MODEL_NAME_OR_PATH=codellama/CodeLlama-7b-Instruct-hf
ADAPTER_PATH=
MODEL_DEVICE=auto
MODEL_USE_4BIT=true
MODEL_WARMUP_ON_START=false

# Used only by LLM_BACKEND=openai_compatible.
MODEL_API_BASE_URL=http://localhost:8001
MODEL_API_KEY=
